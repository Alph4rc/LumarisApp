<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:paddingHorizontal="4dp">

    <!-- 圆角状态条 (类 iOS 日历样式) -->
    <ImageView
        android:id="@+id/course_divider"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/rounded_accent_bar"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- 课程名称 (加粗，主标题) -->
        <TextView
            android:id="@+id/course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="高等数学"
            android:textColor="@color/course_title_text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 详细信息容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <!-- 时间 -->
            <TextView
                android:id="@+id/course_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00 - 10:30"
                android:textColor="@color/course_info_text_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 教室 -->
        <TextView
            android:id="@+id/course_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="教学楼 A101"
            android:textColor="@color/course_info_text_light"
            android:textSize="11sp"
            android:alpha="0.8" />
            
    </LinearLayout>

</LinearLayout>
